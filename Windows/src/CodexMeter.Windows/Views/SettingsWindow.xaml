<Window x:Class="CodexMeter.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexMeter Settings"
        Width="480"
        Height="470"
        MinWidth="480"
        MinHeight="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF1D1F23">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="CodexMeter Settings"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="Windows tray display and local refresh preferences"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource SecondaryText}" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FF292C31"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Number format" VerticalAlignment="Center" />
                <ComboBox x:Name="NumberStyleBox" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Compact (177M)" Tag="Compact" />
                    <ComboBoxItem Content="Detailed (177,000,000)" Tag="Detailed" />
                </ComboBox>

                <TextBlock Grid.Row="1" Text="Week starts on" VerticalAlignment="Center" />
                <ComboBox x:Name="WeekStartBox" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Monday" Tag="Monday" />
                    <ComboBoxItem Content="Sunday" Tag="Sunday" />
                </ComboBox>

                <TextBlock Grid.Row="2" Text="Fallback refresh" VerticalAlignment="Center" />
                <ComboBox x:Name="RefreshBox" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Manual only" Tag="0" />
                    <ComboBoxItem Content="Every 30 seconds" Tag="30" />
                    <ComboBoxItem Content="Every minute" Tag="60" />
                    <ComboBoxItem Content="Every 5 minutes" Tag="300" />
                </ComboBox>

                <TextBlock Grid.Row="3" Text="Cached input row" VerticalAlignment="Center" />
                <CheckBox x:Name="ShowCachedBox"
                          Grid.Row="3"
                          Grid.Column="1"
                          Content="Show"
                          VerticalAlignment="Center" />

                <TextBlock Grid.Row="4" Text="Launch at sign-in" VerticalAlignment="Center" />
                <CheckBox x:Name="LaunchAtLoginBox"
                          Grid.Row="4"
                          Grid.Column="1"
                          Content="Enabled"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Privacy"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Reads token-count events only from %USERPROFILE%\.codex\sessions and archived_sessions. Prompts, responses, source code, credentials, and raw paths are not persisted."
                       Foreground="{StaticResource SecondaryText}"
                       TextWrapping="Wrap" />
            <Button Content="Open GitHub releases"
                    Margin="0,14,0,0"
                    Padding="12,7"
                    HorizontalAlignment="Left"
                    Click="OpenReleasesClicked" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <TextBlock x:Name="ErrorText"
                       Foreground="#FFFF7B72"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center" />
            <Button Content="Cancel"
                    MinWidth="82"
                    Padding="12,7"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="Save"
                    MinWidth="82"
                    Padding="12,7"
                    IsDefault="True"
                    Click="SaveClicked" />
        </StackPanel>
    </Grid>
</Window>
