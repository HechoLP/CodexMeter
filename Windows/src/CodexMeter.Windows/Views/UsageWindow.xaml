<Window x:Class="CodexMeter.Windows.Views.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexMeter"
        Width="340"
        Height="520"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent">
    <Border Background="{StaticResource WindowBackground}"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            CornerRadius="18"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="6"
                              Opacity="0.42"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="22,20,22,12"
                        Orientation="Horizontal">
                <TextBlock Text="◇"
                           FontFamily="Segoe UI Symbol"
                           FontSize="24"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="CodexMeter"
                           Margin="10,0,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="22,4,22,20">
                <TextBlock Text="{Binding TodayTotal}"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="44"
                           FontWeight="SemiBold" />
                <TextBlock Text="Total tokens today"
                           Margin="0,-2,0,18"
                           Foreground="{StaticResource SecondaryText}"
                           FontSize="14" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="↑" Foreground="{StaticResource SecondaryText}" FontSize="18" />
                    <TextBlock Grid.Column="1" Text="Input" Foreground="{StaticResource SecondaryText}" FontSize="15" />
                    <TextBlock Grid.Column="2" Text="{Binding TodayInput}" FontSize="15" />
                </Grid>
                <Grid Margin="0,0,0,8" Visibility="{Binding CachedVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="≈" Foreground="{StaticResource SecondaryText}" FontSize="18" />
                    <TextBlock Grid.Column="1" Text="Cached input" Foreground="{StaticResource SecondaryText}" FontSize="15" />
                    <TextBlock Grid.Column="2" Text="{Binding TodayCachedInput}" FontSize="15" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="↓" Foreground="{StaticResource SecondaryText}" FontSize="18" />
                    <TextBlock Grid.Column="1" Text="Output" Foreground="{StaticResource SecondaryText}" FontSize="15" />
                    <TextBlock Grid.Column="2" Text="{Binding TodayOutput}" FontSize="15" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource DividerBrush}" />

            <Grid Grid.Row="3" Margin="22,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="This Week" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding WeekTotal}" FontSize="16" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1">
                    <TextBlock Text="This Month" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MonthTotal}" FontSize="16" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="2">
                    <TextBlock Text="All Time" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AllTimeTotal}" FontSize="16" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Border Grid.Row="4" Background="{StaticResource DividerBrush}" />

            <Grid Grid.Row="5" Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LastUpdated}"
                               Foreground="#88FFFFFF"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Content="↻"
                        ToolTip="Refresh usage"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}}"
                        Click="RefreshClicked" />
                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Content="⚙"
                        ToolTip="Open Settings"
                        Click="SettingsClicked" />
                <Button Grid.Column="3"
                        Style="{StaticResource IconButton}"
                        Content="⏻"
                        ToolTip="Quit CodexMeter"
                        Click="QuitClicked" />
            </Grid>
        </Grid>
    </Border>
</Window>
